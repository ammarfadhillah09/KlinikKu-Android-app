<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profil Medis Pasien"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2D3436"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lengkapi informasi kesehatan Anda untuk memudahkan pelayanan medis."
            android:textSize="14sp"
            android:textColor="#636E72"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Golongan Darah"
                    android:textStyle="bold"
                    android:textColor="#0984E3"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinnerGolonganDarah"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="15dp"
                    android:entries="@array/golongan_darah_array"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Riwayat Penyakit Bawaan"
                    android:textStyle="bold"
                    android:textColor="#0984E3"
                    android:textSize="12sp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etRiwayatPenyakit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:hint="Contoh: Asma, Diabetes, dll"
                    android:gravity="top"
                    android:background="@drawable/bg_input_field"
                    android:padding="15dp"
                    android:inputType="textMultiLine"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alergi Obat"
                    android:textStyle="bold"
                    android:textColor="#0984E3"
                    android:textSize="12sp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etAlergiObat"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Contoh: Penisilin, Antalgin, dll"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="15dp"
                    android:inputType="text"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnSimpanProfilMedis"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SIMPAN PERUBAHAN"
            android:textStyle="bold"
            android:backgroundTint="#0984E3"
            android:textColor="@color/white"
            android:layout_marginTop="32dp"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>
