<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:animateLayoutChanges="true">

        <TextView
            android:id="@+id/tvTitleRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buat Akun Pasien"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2D3436"
            android:layout_marginTop="20dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="4dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verifikasi NIK"
                    android:textStyle="bold"
                    android:textColor="#0984E3"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etNikPasien"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Masukkan 16 Digit NIK"
                    android:inputType="number"
                    android:maxLength="16"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="15dp"/>

                <TextView
                    android:id="@+id/tvStatusNik"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NIK akan dicek otomatis"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp"
                    android:textColor="#B2BEC3"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/layoutFormPendaftaran"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="15dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="25dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lengkapi Data Akun"
                        android:textStyle="bold"
                        android:textColor="#00B894"
                        android:layout_marginBottom="15dp"/>

                    <EditText
                        android:id="@+id/etNamaPasien"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:enabled="false"
                        android:hint="Nama Lengkap"
                        android:background="@drawable/bg_input_field_disabled"
                        android:paddingHorizontal="15dp"
                        android:layout_marginBottom="12dp"
                        android:textColor="#2D3436"/>

                    <EditText
                        android:id="@+id/etUsernameBaru"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Buat Username"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="15dp"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etPasswordBaru"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Buat Password"
                        android:inputType="textPassword"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="15dp"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etDomisili"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Alamat Domisili Sekarang"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="15dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnSimpanPasien"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="DAFTAR SEKARANG"
                android:textStyle="bold"
                android:backgroundTint="#0984E3"
                android:textColor="@color/white"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
