<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Poli and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvRiwayatPoli"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#E3F2FD"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Poli Umum" />

            <TextView
                android:id="@+id/tvRiwayatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFF3E0"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#F57C00"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Pending" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="12dp" />

        <!-- Doctor Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Dokter:"
                android:textColor="#757575"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRiwayatDokter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Dr. Fulan" />
        </LinearLayout>

        <!-- Target Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Tanggal:"
                android:textColor="#757575"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRiwayatTanggal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#212121"
                android:textSize="14sp"
                tools:text="2024-05-20" />
        </LinearLayout>

        <!-- Ticket Number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="No. Antrean:"
                android:textColor="#757575"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRiwayatNoAntrean"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="5" />
        </LinearLayout>

        <!-- Keluhan -->
        <TextView
            android:id="@+id/tvKeluhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#212121"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            tools:text="Keluhan: Sakit Kepala" />

        <!-- Medical Results Container -->
        <LinearLayout
            android:id="@+id/layoutMedicalResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hasil Pemeriksaan Dokter"
                android:textColor="#37474F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CFD8DC"
                android:layout_marginBottom="8dp" />

            <!-- Diagnosa -->
            <TextView
                android:id="@+id/tvDiagnosa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#212121"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"
                tools:text="Diagnosa Dokter: Flu ringan" />

            <!-- Obat -->
            <TextView
                android:id="@+id/tvObat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#212121"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"
                tools:text="Obat: Paracetamol 3x1" />

            <!-- Catatan Dokter -->
            <TextView
                android:id="@+id/tvCatatanDokter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#212121"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Istirahat yang cukup" />

        </LinearLayout>

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAntrean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATALKAN ANTREAN"
            android:textColor="#FFFFFF"
            app:backgroundTint="#D32F2F"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
