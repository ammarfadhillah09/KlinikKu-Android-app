<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Time Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:minWidth="48dp"
        android:layout_marginEnd="14dp">

        <TextView
            android:id="@+id/tvJamPraktek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/deep_blue"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIB"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"/>
    </LinearLayout>

    <!-- Vertical Accent Line -->
    <View
        android:layout_width="3dp"
        android:layout_height="44dp"
        android:background="@color/emerald_green"
        android:layout_marginEnd="14dp"/>

    <!-- Patient Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNamaPasien"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Pasien"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvJenisKonsultasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Poli Umum"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Badge Status -->
    <TextView
        android:id="@+id/tvBadgeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/badge_terjadwal"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/badge_green"
        android:background="@drawable/bg_badge_green"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
